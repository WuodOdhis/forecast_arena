{
  "name": "forecast-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "backup:local": "tsx scripts/backup-local.ts",
    "backup:d1": "tsx scripts/backup-d1.ts",
    "pretest": "forge build",
    "test": "tsx --test server/*.test.ts src/*.test.ts",
    "test:e2e": "playwright test",
    "contracts:build": "forge build",
    "contracts:test": "forge test -vv",
    "deploy:testnet": "tsx scripts/deploy.ts --broadcast-testnet",
    "deploy:check": "tsx scripts/deploy.ts --dry-run",
    "deploy:mainnet": "tsx scripts/deploy.ts --broadcast-mainnet",
    "verify:round": "tsx scripts/verify-round.ts",
    "worker:dev": "wrangler dev --port 8787",
    "worker:deploy": "wrangler deploy",
    "worker:deploy:staging": "wrangler deploy --env staging",
    "worker:deploy:mainnet": "wrangler deploy --env mainnet",
    "worker:check": "wrangler deploy --dry-run",
    "worker:check:staging": "wrangler deploy --dry-run --env staging",
    "worker:check:mainnet": "wrangler deploy --dry-run --env mainnet"
  },
  "dependencies": {
    "@walletconnect/ethereum-provider": "2.26.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.29.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "zod": "$zod"
  }
}
