GROQ_API_KEY=
# Select testnet, staging, or mainnet. Mainnet is disabled unless its feature flag is enabled.
CHAIN_PROFILE=testnet
CHAIN_CONFIRMATIONS=12
# Dedicated testnet wallet only. Never put this or any other signing key in frontend variables.
DEPLOYER_PRIVATE_KEY=
ARENA_CONTRACT_ADDRESS=
BOT_RPC_URL=https://rpc.bohr.life
# Staging uses a separate testnet wallet/contract and may use its own RPC endpoint.
STAGING_DEPLOYER_PRIVATE_KEY=
STAGING_ARENA_CONTRACT_ADDRESS=
STAGING_BOT_RPC_URL=
STAGING_CHAIN_CONFIRMATIONS=12
# Official BOT mainnet defaults are in shared/chains.ts. Keep these blank unless overriding them.
MAINNET_DEPLOYER_PRIVATE_KEY=
MAINNET_ARENA_CONTRACT_ADDRESS=
BOT_MAINNET_RPC_URL=
MAINNET_CHAIN_CONFIRMATIONS=12
PORT=3001
# Required to authorize mutations when exposing the server beyond localhost.
ADMIN_TOKEN=
GROQ_MODEL_A=openai/gpt-oss-120b
GROQ_MODEL_B=openai/gpt-oss-20b
# Only public website origins belong here; no provider credentials.
ALLOWED_ORIGINS=
# Optional absolute Worker API base URL for isolated frontend deployments.
VITE_API_BASE_URL=
# Optional WalletConnect Cloud project ID (public client identifier).
VITE_WALLETCONNECT_PROJECT_ID=
# New capabilities default to off. Profile-specific values override shared flags.
FEATURE_MAINNET_ONCHAIN=false
FEATURE_WALLET_AUTH=false
FEATURE_USER_CREATED_ROUNDS=false
FEATURE_HUMAN_PREDICTIONS=false
FEATURE_D1_PERSISTENCE=false
# Optional per-profile overrides; these take precedence over shared feature flags.
FEATURE_TESTNET_WALLET_AUTH=
FEATURE_STAGING_WALLET_AUTH=
FEATURE_MAINNET_WALLET_AUTH=
FEATURE_TESTNET_USER_CREATED_ROUNDS=
FEATURE_STAGING_USER_CREATED_ROUNDS=
FEATURE_MAINNET_USER_CREATED_ROUNDS=
FEATURE_TESTNET_HUMAN_PREDICTIONS=
FEATURE_STAGING_HUMAN_PREDICTIONS=
FEATURE_MAINNET_HUMAN_PREDICTIONS=
FEATURE_TESTNET_D1_PERSISTENCE=
FEATURE_STAGING_D1_PERSISTENCE=
FEATURE_MAINNET_D1_PERSISTENCE=
